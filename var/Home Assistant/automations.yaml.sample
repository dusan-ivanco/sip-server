- alias: "SIP Notify"
  id: "SIP Notify"
  max_exceeded: silent
  mode: queued

  triggers:
  - trigger: webhook
    webhook_id: sip_notify
    local_only: true
    allowed_methods:
    - GET

  actions:
  - if:
    - condition: template
      value_template: "{{ trigger.query.state == 'wakeup' }}"

    then:
    - parallel:
      - action: input_boolean.turn_on
        target:
          entity_id: input_boolean.sip_notify
      - action: notify.user
        data:
          title: Doorbell
          message: Someone at the door
          data:
            tag: Doorbell
            channel: Doorbell

            url: /lovelace/doorbell
            clickAction: /lovelace/doorbell
            image: /api/camera_proxy/camera.doorbell

            timeout: 30
            importance: high

            color: red
            ledColor: red
            vibrationPattern: 100,1000,100,1000,100

            push:
              interruption-level: time-sensitive
              sound:
                name: ringing.wav

    else:
    - if:
      - condition: state
        entity_id: input_boolean.sip_notify
        state: "on"

      then:
      - parallel:
        - action: input_boolean.turn_off
          target:
            entity_id: input_boolean.sip_notify
        - action: notify.user
          data:
            message: clear_notification
            data:
              tag: Doorbell
