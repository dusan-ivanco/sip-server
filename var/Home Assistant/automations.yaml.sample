- alias: "SIP Notify"
  id: "SIP Notify"
  max_exceeded: silent
  mode: single

  variables:
    state: "{{ trigger.query.state }}"
    title: "Doorbell"
    message: "Someone at the door"

  triggers:
  - trigger: webhook
    webhook_id: sip_notify
    local_only: false
    allowed_methods:
    - GET

  actions:
  - if:
    - condition: template
      value_template: "{{ state == 'wakeup' }}"
    then:
    - action: camera.snapshot
      target:
        entity_id: camera.doorbell
      data:
        filename: /media/doorbell.jpg
    - parallel:
      - action: input_boolean.turn_on
        target:
          entity_id: input_boolean.sip_notify
      - action: notify.user
        data:
          title: "{{ title }}"
          message: "{{ message }}"
          data:
            tag: Doorbell
            channel: Doorbell

            url: /lovelace/doorbell
            clickAction: /lovelace/doorbell
            image: /media/local/doorbell.jpg

            timeout: 30
            importance: high

            color: red
            ledColor: red
            vibrationPattern: 100,1000,100,1000,100

            push:
              interruption-level: time-sensitive
              sound:
                name: ringing.wav
    else:
    - if:
      - condition: state
        entity_id: input_boolean.sip_notify
        state: "on"
      then:
      - parallel:
        - action: input_boolean.turn_off
          target:
            entity_id: input_boolean.sip_notify
        - action: notify.user
          data:
            message: clear_notification
            data:
              tag: Doorbell
